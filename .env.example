# Copy this file to .env and provide local secrets there.

# Local PostgreSQL used by Docker Compose.
POSTGRES_DB=disclosure_ai
POSTGRES_USER=disclosure_ai
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://disclosure_ai:local-dev-only@localhost:5432/disclosure_ai
CHECKPOINT_DATABASE_URL=postgresql://disclosure_ai:local-dev-only@localhost:5432/disclosure_ai

# Naver LLM
CLOVASTUDIO_API_KEY=

# Retrieval models. Change these without changing graph code.
RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-m3
# Optional stable DB identity; change it when embedding semantics change.
RETRIEVAL_EMBEDDING_STORAGE_ID=
RETRIEVAL_EMBEDDING_DIMENSIONS=1024
RETRIEVAL_EMBEDDING_BATCH_SIZE=32
# Number of model batches loaded and length-sorted as one scheduling window.
RETRIEVAL_EMBEDDING_SCHEDULING_WINDOW_BATCHES=8
RETRIEVAL_EMBEDDING_DEVICE=
RETRIEVAL_NORMALIZE_EMBEDDINGS=true
RETRIEVAL_VECTOR_METRIC=cosine
RETRIEVAL_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_CROSS_ENCODER_BATCH_SIZE=16
RETRIEVAL_CROSS_ENCODER_DEVICE=
RETRIEVAL_NORMALIZE_CROSS_ENCODER_SCORE=true

# Bootstrap retrieval values. Replace them with eval-selected values.
RETRIEVAL_LEXICAL_CANDIDATE_K=50
RETRIEVAL_VECTOR_CANDIDATE_K=50
RETRIEVAL_MAX_TOP_K=10
RETRIEVAL_MINIMUM_SCORE=0.5
RETRIEVAL_EXHAUSTIVE_GRAIN_LIMIT=100
RETRIEVAL_RRF_K=60
RETRIEVAL_POOL_MIN_SIZE=1
RETRIEVAL_POOL_MAX_SIZE=10
